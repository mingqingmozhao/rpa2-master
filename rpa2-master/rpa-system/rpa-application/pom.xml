<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <parent>
        <groupId>com.rpa</groupId>
        <artifactId>rpa-system</artifactId>
        <version>1.0.0</version>
    </parent>
    <modelVersion>4.0.0</modelVersion>

    <artifactId>rpa-application</artifactId>
    <name>rpa-application</name>
    <description>RPA Application Starter Module</description>
    <packaging>jar</packaging>

    <dependencies>
        <dependency>
            <groupId>com.rpa</groupId>
            <artifactId>rpa-system-management</artifactId>
            <version>1.0.0</version>
        </dependency>
        <dependency>
            <groupId>com.rpa</groupId>
            <artifactId>rpa-auth</artifactId>
            <version>1.0.0</version>
        </dependency>
        <dependency>
            <groupId>com.rpa</groupId>
            <artifactId>rpa-task</artifactId>
            <version>1.0.0</version>
        </dependency>
        <dependency>
            <groupId>com.rpa</groupId>
            <artifactId>rpa-process</artifactId>
            <version>1.0.0</version>
        </dependency>
        <dependency>
            <groupId>com.rpa</groupId>
            <artifactId>rpa-robot</artifactId>
            <version>1.0.0</version>
        </dependency>
        <dependency>
            <groupId>com.rpa</groupId>
            <artifactId>rpa-execution</artifactId>
            <version>1.0.0</version>
        </dependency>
        <dependency>
            <groupId>com.rpa</groupId>
            <artifactId>rpa-dataquery</artifactId>
            <version>1.0.0</version>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-jpa</artifactId>
        </dependency>
        <dependency>
            <groupId>com.h2database</groupId>
            <artifactId>h2</artifactId>
            <scope>runtime</scope>
        </dependency>
    </dependencies>

    <build>
        <finalName>rpa-application</finalName>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <configuration>
                    <mainClass>com.rpa.application.RpaApplication</mainClass>
                </configuration>
            </plugin>
            <!-- 使用 exec-maven-plugin 执行 npm 构建（使用系统已安装的 Node.js） -->
            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>exec-maven-plugin</artifactId>
                <version>3.1.0</version>
                <executions>
                    <execution>
                        <id>npm-install</id>
                        <phase>generate-resources</phase>
                        <goals>
                            <goal>exec</goal>
                        </goals>
                        <configuration>
                            <executable>npm</executable>
                            <workingDirectory>../../frontend/rpa-spider-management-web</workingDirectory>
                            <arguments>
                                <argument>install</argument>
                            </arguments>
                        </configuration>
                    </execution>
                    <execution>
                        <id>npm-build</id>
                        <phase>generate-resources</phase>
                        <goals>
                            <goal>exec</goal>
                        </goals>
                        <configuration>
                            <executable>npm</executable>
                            <workingDirectory>../../frontend/rpa-spider-management-web</workingDirectory>
                            <arguments>
                                <argument>run</argument>
                                <argument>build</argument>
                            </arguments>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
        <resources>
            <resource>
                <directory>src/main/resources</directory>
                <includes>
                    <include>**/*</include>
                </includes>
            </resource>
        </resources>
    </build>

</project>
